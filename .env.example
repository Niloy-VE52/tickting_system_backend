# Google Gemini API key (for parsing emails into structured fields)
# Get your API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the model used for parsing (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Gmail IMAP login for fetching incoming resident issues
GMAIL_ADDRESS=your-email@example.com
GMAIL_APP_PASSWORD=your-16-char-app-password
IMAP_HOST=imap.gmail.com
GMAIL_QUERY=UNSEEN
GMAIL_PROCESSED_LABEL=Ticket-Created

# Database connection (defaults to SQLite if unset)
DATABASE_LINK=sqlite:///tickets.db

# Authentication & CORS Security
AUTH_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
